# Developer Agent LLM provider (Groq is the default for faster code/QA generation)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google API key is still used by the optional Gemini provider and Google embeddings/RAG.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEVELOPER_SERVICE_KEY=

CONTEXT_MODE=all_files
RUNNER_MODE=docker
# QA_AUTO_REPAIR_ROUNDS=2
# APP_TTL_SECONDS=900
